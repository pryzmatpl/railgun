# Build output
dist/
*.tsbuildinfo

# Dependencies
node_modules/

# Local state — never commit a store, an audit chain or a secret file
data/
*.db
*.db-wal
*.db-shm
*.ndjson
secrets/

# Credentials and local overrides
.env
.env.*
!.env.example

# Coverage and logs
coverage/
*.log
npm-debug.log*

# Release evidence is generated by `npm run release:check`; it is a report,
# not a source file, and it is regenerated by every release run.
release-evidence.json

# Editors and OS noise
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
